# ---------------------------------------------------------------------------
# Database — a single SQLite file, created automatically. No server needed.
# On the VPS keep it on persistent disk and back the file up.
# ---------------------------------------------------------------------------
DATABASE_PATH="./data/gmb.sqlite"

# Encryption key for stored account passwords / 2FA secrets AND the login
# session signing key. Any long random string (openssl rand -hex 32). If empty,
# a key is generated once at data/app-secret.key — back that file up together
# with the database.
APP_SECRET=""

# Daily cap on Google Places API calls (protects against surprise bills).
GOOGLE_DAILY_CALL_LIMIT=10000
# Kill switch: 1 = block every Google Places API call (imports still work from Maps links).
GOOGLE_API_DISABLED=0

# ---------------------------------------------------------------------------
# Google Places API (enable "Places API" in Google Cloud, restrict key by API)
# ---------------------------------------------------------------------------
GOOGLE_PLACES_API_KEY=""
# Which Google service the key is enabled for: legacy | new | auto (tries legacy, falls back to new)
GOOGLE_PLACES_API_VERSION="auto"
# Country calling code assumed for phone numbers when the address doesn't say (France = 33, US = 1, BD = 880)
DEFAULT_PHONE_COUNTRY_CODE="33"

# ---------------------------------------------------------------------------
# Cron protection. Crontab / Vercel sends `Authorization: Bearer <CRON_SECRET>`.
# Generate with: openssl rand -hex 32
# ---------------------------------------------------------------------------
CRON_SECRET=""
# Shown on the Schedule page. Must match the crontab / vercel.json schedule (UTC).
CRON_SCHEDULE="0 3 * * *"

# ---------------------------------------------------------------------------
# Telegram alerts (optional — skipped when empty)
# 1. Create a bot with @BotFather → TELEGRAM_BOT_TOKEN
# 2. Message the bot, then GET https://api.telegram.org/bot<TOKEN>/getUpdates → chat.id
# ---------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""

# ---------------------------------------------------------------------------
# Email alerts via Resend (optional — skipped when empty)
# ---------------------------------------------------------------------------
RESEND_API_KEY=""
ALERT_EMAIL_FROM="GMB Guard <alerts@yourdomain.com>"
# Comma-separated list of recipients (more can be added in the app under Alerts)
ALERT_EMAIL_TO="you@yourdomain.com"

# ---------------------------------------------------------------------------
# Tuning (optional)
# ---------------------------------------------------------------------------
# Parallel Google requests per batch (1–50)
GMB_CHECK_CONCURRENCY=10
# Pause between batches in ms — raise if you see OVER_QUERY_LIMIT
GMB_BATCH_DELAY_MS=0
# Per-request timeout for Google Places in ms
GOOGLE_PLACES_TIMEOUT_MS=8000
# Public dashboard URL used for deep links in alerts
APP_URL="https://gmb.yourdomain.com"
